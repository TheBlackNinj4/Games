        ]

        layout_principal = [[sg.TabGroup([[
            sg.Tab("Estruturas Clínicas", [[sg.TabGroup([[sg.Tab("Clínicas", sub_tab_clinicas, background_color=COR_FUNDO_ABAS), sg.Tab("Tipos de Atendimento", sub_tab_tipos, background_color=COR_FUNDO_ABAS)]], **config_abas)]], background_color=COR_FUNDO_JANELA),
            sg.Tab("Gerenciamento de Pacientes", layout_pacientes, background_color=COR_FUNDO_ABAS),
            sg.Tab("Corpo Clínico / Médicos", layout_profissionais, background_color=COR_FUNDO_ABAS),
            sg.Tab("Agendamentos & Procedimentos", layout_atendimento, background_color=COR_FUNDO_ABAS),
            sg.Tab("Caixa / Financeiro & Relatórios", layout_aba_financeira, background_color=COR_FUNDO_ABAS)
        ]], expand_y=True, **config_abas)]]

        return sg.Window("Sistema de Gestão Clínica Integrada", layout_principal, size=(1050, 750), finalize=True, background_color=COR_FUNDO_JANELA)

    def _atualizar_tabelas_e_combos(self, window):
        window["-TAB_CLINICAS-"].update(values=[[c.nome, c.cidade, f"{c.hora_abertura.hour}h-{c.hora_fechamento.hour}h"] for c in self.controller.listar_clinicas()])
        window["-TAB_TIPOS-"].update(values=[[t.nome, f"R$ {t.preco_base:.2f}"] for t in self.controller.listar_tipos_atendimento()])
        
        window["-TAB_PACIENTES-"].update(values=[[p.nome, formatar_cpf(p.cpf), f"{p.idade} anos", formatar_celular(p.celular)] for p in self.controller.listar_pacientes()])
        window["-TAB_PROFISSIONAIS-"].update(values=[[prof.nome, prof.especialidade, prof.registro_profissional, formatar_cpf(prof.cpf)] for prof in self.controller.listar_profissionais()])
        
        agenda_dados, fin_dados = [], []
        for a in self.controller.listar_atendimentos():
            agenda_dados.append([a.id, a.paciente.nome, a.clinica.nome, a.profissional.nome, a.tipo_atendimento.nome, f"{a.hora_inicio.hour}h-{a.hora_fim.hour}h", f"R$ {a.valor_total:.2f}"])
            status = ", ".join(str(p.modalidade) for p in a.pagamentos) if a.pagamentos else "Em aberto"
            if a.valor_restante == 0: status = f"Quitado ({status})"
            fin_dados.append([a.id, a.paciente.nome, f"R$ {a.valor_restante:.2f}", status])
        
        window["-TAB_AGENDA-"].update(values=agenda_dados)
        window["-TAB_FIN_CONSULTAS-"].update(values=fin_dados)

        nomes_cli = [c.nome for c in self.controller.listar_clinicas()]
        nomes_tp = [t.nome for t in self.controller.listar_tipos_atendimento()]
        
        combos_pac = [f"{p.nome} | {formatar_cpf(p.cpf)}" for p in self.controller.listar_pacientes()]
        combos_prof = [f"{prof.nome} | {formatar_cpf(prof.cpf)}" for prof in self.controller.listar_profissionais()]

        window["-AT_CLI-"].update(values=nomes_cli)
        window["-AT_TIPO-"].update(values=nomes_tp)
        window["-AT_PAC-"].update(values=combos_pac)
        window["-AT_PROF-"].update(values=combos_prof)
        window["-PROC_PROF-"].update(values=combos_prof)

    def rodar(self):
        window = self.construir_layout()
        self._atualizar_tabelas_e_combos(window)

        while True:
            event, valores = window.read()
            if event in (sg.WINDOW_CLOSED, "Exit"): break

            if event in ("-PAC_CPF-", "-PROF_CPF-", "-FIN_PIX_CPF-"):
                texto_formatado = formatar_cpf(valores[event])
                if valores[event] != texto_formatado:
                    window[event].update(texto_formatado)

            elif event in ("-PAC_CEL-", "-PROF_CEL-"):
                texto_formatado = formatar_celular(valores[event])
                if valores[event] != texto_formatado:
                    window[event].update(texto_formatado)

            try:
                if event == "-FIN_MODALIDADE-":
                    window["-FR_PIX-"].update(visible=(valores["-FIN_MODALIDADE-"] == "Pix"))
                    window["-FR_CARD-"].update(visible=(valores["-FIN_MODALIDADE-"] == "Cartão"))

                elif event == "-BTN_CLI-":
                    self.controller.cadastrar_clinica(valores["-CLI_NOME-"], valores["-CLI_CIDADE-"], valores["-CLI_DESC-"], int(valores["-CLI_ABER-"]), int(valores["-CLI_FECH-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_CLI_ALT-":
                    self.controller.alterar_clinica(valores["-CLI_NOME-"], valores["-CLI_CIDADE-"], valores["-CLI_DESC-"], int(valores["-CLI_ABER-"]), int(valores["-CLI_FECH-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_CLI_EXC-":
                    self.controller.excluir_clinica(valores["-CLI_NOME-"])
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-TAB_CLINICAS-" and valores["-TAB_CLINICAS-"]:
                    obj = self.controller.listar_clinicas()[valores["-TAB_CLINICAS-"][0]]
                    window["-CLI_NOME-"].update(obj.nome)
                    window["-CLI_CIDADE-"].update(obj.cidade)
                    window["-CLI_DESC-"].update(obj.descricao)
                    window["-CLI_ABER-"].update(obj.hora_abertura.hour)
                    window["-CLI_FECH-"].update(obj.hora_fechamento.hour)

                elif event == "-BTN_TP-":
                    self.controller.cadastrar_tipo_atendimento(valores["-TP_NOME-"], float(valores["-TP_PRECO-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_TP_ALT-":
                    self.controller.alterar_tipo_atendimento(valores["-TP_NOME-"], float(valores["-TP_PRECO-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_TP_EXC-":
                    self.controller.excluir_tipo_atendimento(valores["-TP_NOME-"])
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-TAB_TIPOS-" and valores["-TAB_TIPOS-"]:
                    obj = self.controller.listar_tipos_atendimento()[valores["-TAB_TIPOS-"][0]]
                    window["-TP_NOME-"].update(obj.nome)
                    window["-TP_PRECO-"].update(obj.preco_base)

                elif event == "-BTN_PAC-":
                    self.controller.cadastrar_paciente(valores["-PAC_NOME-"], valores["-PAC_CEL-"], valores["-PAC_CPF-"], self._analisar_data(valores["-PAC_DATA-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_PAC_ALT-":
                    self.controller.alterar_paciente(valores["-PAC_NOME-"], valores["-PAC_CEL-"], valores["-PAC_CPF-"], self._analisar_data(valores["-PAC_DATA-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_PAC_EXC-":
                    self.controller.excluir_paciente(valores["-PAC_CPF-"])
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-TAB_PACIENTES-" and valores["-TAB_PACIENTES-"]:
                    obj = self.controller.listar_pacientes()[valores["-TAB_PACIENTES-"][0]]
                    window["-PAC_NOME-"].update(obj.nome)
                    window["-PAC_CPF-"].update(formatar_cpf(obj.cpf))
                    window["-PAC_CEL-"].update(formatar_celular(obj.celular))
                    window["-PAC_DATA-"].update(obj.data_nascimento.strftime("%d/%m/%Y"))

                elif event == "-BTN_PROF-":
                    self.controller.cadastrar_profissional(valores["-PROF_NOME-"], valores["-PROF_CEL-"], valores["-PROF_CPF-"], self._analisar_data(valores["-PROF_DATA-"]), valores["-PROF_ESP-"], valores["-PROF_REG-"])
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_PROF_ALT-":
                    self.controller.alterar_profissional(valores["-PROF_NOME-"], valores["-PROF_CEL-"], valores["-PROF_CPF-"], self._analisar_data(valores["-PROF_DATA-"]), valores["-PROF_ESP-"], valores["-PROF_REG-"])
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_PROF_EXC-":
                    self.controller.excluir_profissional(valores["-PROF_CPF-"])
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-TAB_PROFISSIONAIS-" and valores["-TAB_PROFISSIONAIS-"]:
                    obj = self.controller.listar_profissionais()[valores["-TAB_PROFISSIONAIS-"][0]]
                    window["-PROF_NOME-"].update(obj.nome)
                    window["-PROF_CPF-"].update(formatar_cpf(obj.cpf))
                    window["-PROF_CEL-"].update(formatar_celular(obj.celular))
                    window["-PROF_ESP-"].update(obj.especialidade)
                    window["-PROF_REG-"].update(obj.registro_profissional)
                    window["-PROF_DATA-"].update(obj.data_nascimento.strftime("%d/%m/%Y"))

                elif event == "-BTN_ATEND-":
                    self.controller.agendar_atendimento(valores["-AT_CLI-"], valores["-AT_PAC-"].split("|")[-1].strip(), valores["-AT_PROF-"].split("|")[-1].strip(), valores["-AT_TIPO-"], int(valores["-AT_INI-"]), int(valores["-AT_FIM-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_AT_ALT-":
                    self.controller.alterar_atendimento(int(valores["-AT_ID-"]), valores["-AT_CLI-"], valores["-AT_PAC-"].split("|")[-1].strip(), valores["-AT_PROF-"].split("|")[-1].strip(), valores["-AT_TIPO-"], int(valores["-AT_INI-"]), int(valores["-AT_FIM-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-BTN_AT_EXC-":
                    self.controller.excluir_atendimento(int(valores["-AT_ID-"]))
                    self._atualizar_tabelas_e_combos(window)
                elif event == "-TAB_AGENDA-" and valores["-TAB_AGENDA-"]:
                    obj = self.controller.listar_atendimentos()[valores["-TAB_AGENDA-"][0]]
                    window["-AT_ID-"].update(obj.id)
                    window["-AT_CLI-"].update(obj.clinica.nome)
                    window["-AT_TIPO-"].update(obj.tipo_atendimento.nome)
                    window["-AT_PAC-"].update(f"{obj.paciente.nome} | {formatar_cpf(obj.paciente.cpf)}")
                    window["-AT_PROF-"].update(f"{obj.profissional.nome} | {formatar_cpf(obj.profissional.cpf)}")
                    window["-AT_INI-"].update(obj.hora_inicio.hour)
                    window["-AT_FIM-"].update(obj.hora_fim.hour)

                elif event == "-BTN_ADD_PROC-":
                    if not valores["-AT_ID-"]: raise RegraNegocioError("Selecione um atendimento na tabela antes.")
                    self.controller.adicionar_procedimento_no_atendimento(int(valores["-AT_ID-"]), valores["-PROC_DESC-"], float(valores["-PROC_CUSTO-"]), valores["-PROC_PROF-"].split("|")[-1].strip())
                    sg.popup_ok("Procedimento vinculado ao atendimento com sucesso!")
                    self._atualizar_tabelas_e_combos(window)

                elif event == "-TAB_FIN_CONSULTAS-" and valores["-TAB_FIN_CONSULTAS-"]:
                    obj = self.controller.listar_atendimentos()[valores["-TAB_FIN_CONSULTAS-"][0]]
                    window["-FIN_ID-"].update(obj.id)
                    window["-FIN_VAL-"].update(f"{obj.valor_restante:.2f}")
                elif event == "-BTN_PAGAR-":
                    if not valores["-FIN_ID-"]: raise RegraNegocioError("Selecione uma fatura pendente.")
                    id_at = int(valores["-FIN_ID-"])
                    val_p = float(valores["-FIN_VAL-"])
                    mod_str = valores["-FIN_MODALIDADE-"]
                    
                    if mod_str == "Dinheiro": mod_obj = PagamentoDinheiro()
                    elif mod_str == "Pix": mod_obj = PagamentoPix(valores["-FIN_PIX_CPF-"])
                    else: mod_obj = PagamentoCartao(valores["-FIN_CARD_NUM-"], valores["-FIN_CARD_BAND-"])
                    
                    self.controller.registrar_pagamento(id_at, val_p, mod_obj)
                    self._atualizar_tabelas_e_combos(window)

                elif event == "-BTN_REL-":
                    dados = self.controller.relatorio_faturamento_total()
                    rel = "=========================================================================\n"
                    rel += "                RELATORIO GERENCIAL - ARRECADACAO POR UNIDADE\n"
                    rel += "=========================================================================\n"
                    for nome, total, qtd in dados:
                        rel += f" Unidade Clinica: {nome.ljust(22)} | Atendimentos: {str(qtd).ljust(4)} | Caixa: R$ {total:.2f}\n"
                    rel += "=========================================================================\n"
                    window["-DISPLAY_REL-"].update(rel)

            except Exception as e:
                sg.popup_error(f"Erro Operacional:\n\n{e}", title="Aviso")

        window.close()

if __name__ == "__main__":
    ctrl = ClinicaController()

    if not ctrl.listar_clinicas():
        ctrl.cadastrar_clinica("Centro Medico Alpha", "Florianopolis", "Atendimento Geral", 8, 20)
        ctrl.cadastrar_tipo_atendimento("Consulta Rotina", 150.00)
        ctrl.cadastrar_tipo_atendimento("Exame Complexo", 350.00)
        ctrl.cadastrar_paciente("Rodrigo Ramos", "48988888888", "01122233344", date(1995, 8, 10))
        ctrl.cadastrar_profissional("Dr. Marcos", "48977777777", "99988877766", date(1980, 4, 12), "Cardiologia", "CRM-SC 9999")

    app = ClinicaGUI(ctrl)
    app.rodar()
