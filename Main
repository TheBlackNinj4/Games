def formatar_cpf(texto: str) -> str:
    digitos = re.sub(r'\D', '', texto)[:11]
    if len(digitos) <= 3:
        return digitos
    elif len(digitos) <= 6:
        return f"{digitos[:3]}.{digitos[3:]}"
    elif len(digitos) <= 9:
        return f"{digitos[:3]}.{digitos[3:6]}.{digitos[6:]}"
    else:
        return f"{digitos[:3]}.{digitos[3:6]}.{digitos[6:9]}-{digitos[9:]}"

def formatar_celular(texto: str) -> str:
    digitos = re.sub(r'\D', '', texto)[:11]
    if len(digitos) <= 2:
        return digitos
    elif len(digitos) <= 6:
        return f"({digitos[:2]}) {digitos[2:]}"
    elif len(digitos) <= 10:
        return f"({digitos[:2]}) {digitos[2:6]}-{digitos[6:]}"
    else:
        return f"({digitos[:2]}) {digitos[2:7]}-{digitos[7:]}"

class SistemaClinicaError(Exception): pass
class RegistroNaoEncontradoError(SistemaClinicaError): pass
class RegistroDuplicadoError(SistemaClinicaError): pass
class RegraNegocioError(SistemaClinicaError): pass

class Clinica:
    def __init__(self, nome: str, cidade: str, descricao: str, hora_abertura: time, hora_fechamento: time):
        self.nome = nome
        self.cidade = cidade
        self.descricao = descricao
        self.hora_abertura = hora_abertura
        self.hora_fechamento = hora_fechamento

class TipoAtendimento:
    def __init__(self, nome: str, preco_base: float):
        self.nome = nome
        self.preco_base = preco_base

class Pessoa(ABC):
    def __init__(self, nome: str, celular: str, cpf: str, data_nascimento: date):
        self.nome = nome
        self.celular = re.sub(r'\D', '', celular)
        self.cpf = re.sub(r'\D', '', cpf)
        self.data_nascimento = data_nascimento

    @property
    def idade(self) -> int:
        hoje = date.today()
        return hoje.year - self.data_nascimento.year - (
            (hoje.month, hoje.day) < (self.data_nascimento.month, self.data_nascimento.day)
        )

class Paciente(Pessoa):
    def pode_realizar_atendimento_independente(self) -> bool:
        return self.idade >= 18

class ProfissionalSaude(Pessoa):
    def __init__(self, nome: str, celular: str, cpf: str, data_nascimento: date, especialidade: str, registro_profissional: str):
        super().__init__(nome, celular, cpf, data_nascimento)
        self.especialidade = especialidade
        self.registro_profissional = registro_profissional

class Procedimento:
    def __init__(self, descricao: str, custo: float, profesional_responsavel: ProfissionalSaude):
        self.descricao = descricao
        self.custo = custo
        self.profissional_responsavel = profesional_responsavel

class ModalidadePagamento(ABC):
    @abstractmethod
    def __str__(self) -> str: pass

class PagamentoDinheiro(ModalidadePagamento):
    def __str__(self): return "Dinheiro"

class PagamentoPix(ModalidadePagamento):
    def __init__(self, cpf_pagador: str): self.cpf_pagador = re.sub(r'\D', '', cpf_pagador)
    def __str__(self): return f"PIX (CPF: {self.cpf_pagador})"

class PagamentoCartao(ModalidadePagamento):
    def __init__(self, numero_cartao: str, bandeira: str):
        self.numero_cartao = re.sub(r'\D', '', numero_cartao)
        self.bandeira = bandeira
    def __str__(self): return f"Cartão {self.bandeira} (*{self.numero_cartao[-4:] if len(self.numero_cartao)>=4 else self.numero_cartao})"

class Pagamento:
    def __init__(self, data: date, valor_pago: float, modalidade: ModalidadePagamento):
        self.data = data
        self.valor_pago = valor_pago
        self.modalidade = modalidade

class Atendimento:
    def __init__(self, id_atendimento: int, clinica: Clinica, paciente: Paciente, profissional: ProfissionalSaude, 
                 tipo_atendimento: TipoAtendimento, data: date, hora_inicio: time, hora_fim: time):
        self.id = id_atendimento
        self.clinica = clinica
        self.paciente = paciente
        self.profissional = profissional
        self.tipo_atendimento = tipo_atendimento
        self.data = data
        self.hora_inicio = hora_inicio
        self.hora_fim = hora_fim
        self.procedimentos_realizados: List[Procedimento] = []
        self.pagamentos: List[Pagamento] = []

    @property
    def valor_total(self) -> float:
        custo_procedimentos = sum(p.custo for p in self.procedimentos_realizados)
        return self.tipo_atendimento.preco_base + custo_procedimentos

    @property
    def valor_pago(self) -> float:
        return sum(p.valor_pago for p in self.pagamentos)

    @property
    def valor_restante(self) -> float:
        return max(0.0, self.valor_total - self.valor_pago)

class DAO(ABC):
    def __init__(self, nome_arquivo=""):
        diretorio_atual = os.path.dirname(os.path.abspath(__file__))
        self.fonte_dados = os.path.join(diretorio_atual, nome_arquivo)
        self._memoria = {}
        self._carregar()

    def _carregar(self):
        if os.path.exists(self.fonte_dados):
            try:
                with open(self.fonte_dados, 'rb') as f:
                    self._memoria = pickle.load(f)
            except:
                self._memoria = {}

    def _salvar(self):
        with open(self.fonte_dados, 'wb') as f:
            pickle.dump(self._memoria, f)

    def adicionar(self, chave, objeto):
        self._memoria[chave] = objeto
        self._salvar()

    def obter(self, chave):
        return self._memoria.get(chave)

    def remover(self, chave):
        if chave in self._memoria:
            del self._memoria[chave]
            self._salvar()

    def obter_todos(self):
        return list(self._memoria.values())

class ClinicaDAO(DAO):
    def __init__(self): super().__init__("clinicas.pkl")

class PacienteDAO(DAO):
    def __init__(self): super().__init__("pacientes.pkl")

class ProfissionalDAO(DAO):
    def __init__(self): super().__init__("profissionais.pkl")

class TipoAtendimentoDAO(DAO):
    def __init__(self): super().__init__("tipos_atendimento.pkl")

class AtendimentoDAO(DAO):
    def __init__(self): super().__init__("atendimentos.pkl")

class ClinicaController:
    def __init__(self):
        self.clinica_dao = ClinicaDAO()
        self.paciente_dao = PacienteDAO()
        self.profissional_dao = ProfissionalDAO()
        self.tipo_atendimento_dao = TipoAtendimentoDAO()
        self.atendimento_dao = AtendimentoDAO()
        self.id_contador = max([a.id for a in self.atendimento_dao.obter_todos()] + [0]) + 1

    def cadastrar_clinica(self, nome: str, cidade: str, descricao: str, h_abertura: int, h_fechamento: int) -> None:
        if not nome: raise RegraNegocioError("Nome inválido.")
        if self.clinica_dao.obter(nome): raise RegistroDuplicadoError("Clínica já cadastrada.")
        self.clinica_dao.adicionar(nome, Clinica(nome, cidade, descricao, time(h_abertura, 0), time(h_fechamento, 0)))

    def alterar_clinica(self, nome: str, city: str, descricao: str, h_abertura: int, h_fechamento: int) -> None:
        if not self.clinica_dao.obter(nome): raise RegistroNaoEncontradoError("Clínica não encontrada.")
        self.clinica_dao.adicionar(nome, Clinica(nome, city, descricao, time(h_abertura, 0), time(h_fechamento, 0)))

    def excluir_clinica(self, nome: str) -> None:
        if not self.clinica_dao.obter(nome): raise RegistroNaoEncontradoError("Clínica não encontrada.")
        self.clinica_dao.remover(nome)

    def listar_clinicas(self) -> List[Clinica]: return self.clinica_dao.obter_todos()

    def cadastrar_paciente(self, nome: str, celular: str, cpf: str, data_nasc: date) -> None:
        num_cpf = re.sub(r'\D', '', cpf)
        if not num_cpf: raise RegraNegocioError("CPF obrigatório.")
        if self.paciente_dao.obter(num_cpf): raise RegistroDuplicadoError("Paciente já existe.")
        self.paciente_dao.adicionar(num_cpf, Paciente(nome, celular, num_cpf, data_nasc))

    def alterar_paciente(self, nome: str, celular: str, cpf: str, data_nasc: date) -> None:
        num_cpf = re.sub(r'\D', '', cpf)
        if not self.paciente_dao.obter(num_cpf): raise RegistroNaoEncontradoError("Paciente não encontrado.")
        self.paciente_dao.adicionar(num_cpf, Paciente(nome, celular, num_cpf, data_nasc))

    def excluir_paciente(self, cpf: str) -> None:
        num_cpf = re.sub(r'\D', '', cpf)
        self.paciente_dao.remover(num_cpf)

    def listar_pacientes(self) -> List[Paciente]: return self.paciente_dao.obter_todos()

    def cadastrar_profissional(self, nome: str, celular: str, cpf: str, data_nasc: date, esp: str, reg: str) -> None:
        num_cpf = re.sub(r'\D', '', cpf)
        if self.profissional_dao.obter(num_cpf): raise RegistroDuplicadoError("Profissional já existe.")
        self.profissional_dao.adicionar(num_cpf, ProfissionalSaude(nome, celular, num_cpf, data_nasc, esp, reg))

    def alterar_profissional(self, nome: str, celular: str, cpf: str, data_nasc: date, esp: str, reg: str) -> None:
        num_cpf = re.sub(r'\D', '', cpf)
        if not self.profissional_dao.obter(num_cpf): raise RegistroNaoEncontradoError("Profissional não cadastrado.")
        self.profissional_dao.adicionar(num_cpf, ProfissionalSaude(nome, celular, num_cpf, data_nasc, esp, reg))

    def excluir_profissional(self, cpf: str) -> None:
        num_cpf = re.sub(r'\D', '', cpf)
        self.profissional_dao.remover(num_cpf)

    def listar_profissionais(self) -> List[ProfissionalSaude]: return self.profissional_dao.obter_todos()

    def cadastrar_tipo_atendimento(self, nome: str, preco_base: float) -> None:
        if not nome: raise RegraNegocioError("Nome inválido.")
        if self.tipo_atendimento_dao.obter(nome): raise RegistroDuplicadoError("Tipo já cadastrado.")
        self.tipo_atendimento_dao.adicionar(nome, TipoAtendimento(nome, preco_base))

    def alterar_tipo_atendimento(self, nome: str, preco_base: float) -> None:
        if not self.tipo_atendimento_dao.obter(nome): raise RegistroNaoEncontradoError("Tipo não encontrado.")
        self.tipo_atendimento_dao.adicionar(nome, TipoAtendimento(nome, preco_base))

    def excluir_tipo_atendimento(self, nome: str) -> None:
        self.tipo_atendimento_dao.remover(nome)

    def listar_tipos_atendimento(self) -> List[TipoAtendimento]: return self.tipo_atendimento_dao.obter_todos()

    def agendar_atendimento(self, nome_clinica: str, cpf_paciente: str, cpf_prof: str, nome_tipo: str, h_inicio: int, h_fim: int) -> int:
        clinica = self.clinica_dao.obter(nome_clinica)
        paciente = self.paciente_dao.obter(re.sub(r'\D', '', cpf_paciente))
        prof = self.profissional_dao.obter(re.sub(r'\D', '', cpf_prof))
        tipo_at = self.tipo_atendimento_dao.obter(nome_tipo)

        if not all([clinica, paciente, prof, tipo_at]): raise RegistroNaoEncontradoError("Entidades vinculadas inválidas.")
        if not paciente.pode_realizar_atendimento_independente(): raise RegraNegocioError("Paciente menor de idade sem permissão independente.")

        inicio, fim = time(h_inicio, 0), time(h_fim, 0)
        if inicio >= fim: raise RegraNegocioError("Horário final deve ser maior que o inicial.")

        novo = Atendimento(self.id_contador, clinica, paciente, prof, tipo_at, date.today(), inicio, fim)
        self.atendimento_dao.adicionar(novo.id, novo)
        self.id_contador += 1
        return novo.id

    def alterar_atendimento(self, id_atend: int, nome_clinica: str, cpf_paciente: str, cpf_prof: str, nome_tipo: str, h_inicio: int, h_fim: int) -> None:
        atend = self.atendimento_dao.obter(id_atend)
        if not atend: raise RegistroNaoEncontradoError("Agendamento não localizado.")
        
        atend.clinica = self.clinica_dao.obter(nome_clinica)
        atend.paciente = self.paciente_dao.obter(re.sub(r'\D', '', cpf_paciente))
        atend.profissional = self.profissional_dao.obter(re.sub(r'\D', '', cpf_prof))
        atend.tipo_atendimento = self.tipo_atendimento_dao.obter(nome_tipo)
        atend.hora_inicio = time(h_inicio, 0)
        atend.hora_fim = time(h_fim, 0)
        self.atendimento_dao.adicionar(atend.id, atend)

    def excluir_atendimento(self, id_atend: int) -> None:
        self.atendimento_dao.remover(id_atend)

    def listar_atendimentos(self) -> List[Atendimento]: return self.atendimento_dao.obter_todos()

    def adicionar_procedimento_no_atendimento(self, id_atend: int, desc: str, custo: float, cpf_prof: str) -> None:
        atend = self.atendimento_dao.obter(id_atend)
        prof = self.profissional_dao.obter(re.sub(r'\D', '', cpf_prof))
        if not atend or not prof: raise RegistroNaoEncontradoError("Atendimento ou Profissional inválido.")
        
        atend.procedimentos_realizados.append(Procedimento(desc, custo, prof))
        self.atendimento_dao.adicionar(atend.id, atend)

    def registrar_pagamento(self, id_atend: int, valor: float, modalidade: ModalidadePagamento) -> None:
        atend = self.atendimento_dao.obter(id_atend)
        if not atend: raise RegistroNaoEncontradoError("Atendimento não encontrado.")
        if valor > atend.valor_restante: raise RegraNegocioError("Valor superior ao saldo devedor.")
        
        atend.pagamentos.append(Pagamento(date.today(), valor, modalidade))
        self.atendimento_dao.adicionar(atend.id, atend)

    def relatorio_faturamento_total(self) -> List[tuple]:
        resumo = {c.nome: {"total": 0.0, "qtd": 0} for c in self.clinica_dao.obter_todos()}
        for a in self.atendimento_dao.obter_todos():
            if a.clinica.nome in resumo:
                resumo[a.clinica.nome]["total"] += a.valor_pago
                resumo[a.clinica.nome]["qtd"] += 1
        return [(k, v["total"], v["qtd"]) for k, v in resumo.items()]

class ClinicaGUI:
